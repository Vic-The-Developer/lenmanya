<%- include('./_layouts/header') %>


<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>


<!-- Admin Profile Card -->
<div class="container">
    <div class="card card-profile bg-white">
        <h3 class="text-center text-primary mb-4">
            Admin Profile Information
        </h3>
        <form action="/admin/edit_profile" method="post" enctype="application/x-www-form-urlencoded">
            <!-- Display Name -->
            <div class="mb-3">
                <label for="displayName" class="form-label">Display Name</label>
                <input type="text" id="displayName" name="displayName" class="form-control" placeholder="Admin Name" value="John Doe">
            </div>
            <!-- Email Address -->
            <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="admin@example.com" value="admin@example.com">
            </div>
            <!-- Phone Number -->
            <div class="mb-3">
                <label for="phone" class="form-label">Phone Number</label>
                <input type="tel" id="phone" name="phone" class="form-control" placeholder="+123456789" value="+123456789">
            </div>
            <!-- Password Update -->
            <div class="mb-4">
                <label for="password" class="form-label">Update Password</label>
                <input type="password" id="password" name="oldPass" class="form-control" placeholder="Enter old password">
                <input type="password" id="password" name="newPass" class="form-control" placeholder="Enter new password">
            </div>
            <!-- Update Button -->
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i> Update Profile
                </button>
                <a href="/admin/logout" class="btn logout-btn">
                    <i class="fa fa-sign-out-alt"></i> Logout
                </a>
            </div>
            <div style="margin-top: 40px; text-align: center;">
                <a href="#" class="btn btn-success" data-toggle="modal" data-target=".bd-example-modal-lg">Add New Admin</a>
            </div>
        </form>
    </div>

    <h2 class="text-primary mb-4">Admin Accounts</h2>

    <!-- Admin Table -->
    <table class="table table-striped table-bordered">
        <thead class="thead-secondary">
            <tr>
                <th>#</th>
                <th>Display Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <!-- Example Admins -->
            <tr>
                <td>1</td>
                <td>John Doe</td>
                <td>john@example.com</td>
                <td>SuperAdmin</td>
                <td>
                    <button class="btn btn-danger btn-sm" onclick="deleteAdmin(1)">
                        <i class="fa fa-trash"></i> &nbsp; Delete
                    </button>
                    <button class="btn btn-warning btn-sm" onclick="revokeAccess(1)">
                        <i class="fa fa-ban"></i> &nbsp; Revoke Access
                    </button>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td>Jane Smith</td>
                <td>jane@example.com</td>
                <td>Admin</td>
                <td>
                    <button class="btn btn-danger btn-sm" onclick="deleteAdmin(2)">
                        <i class="fa fa-trash"></i> &nbsp; Delete
                    </button>
                    <button class="btn btn-warning btn-sm" onclick="revokeAccess(2)">
                        <i class="fa fa-ban"></i> &nbsp; Revoke Access
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Create New Admin</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <form action="/admin/new_admin" method="post" enctype="application/x-www-form-urlencoded">
                <!-- Display Name -->
                <div class="mb-3">
                    <label for="displayName" class="form-label">Display Name</label>
                    <input type="text" id="displayName" name="displayName" class="form-control" placeholder="Admin Name" value="John Doe">
                </div>
                <!-- Email Address -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="admin@example.com" value="admin@example.com">
                </div>
                <!-- Phone Number -->
                <div class="mb-3">
                    <label for="phone" class="form-label">Phone Number (Optional)</label>
                    <input type="tel" id="phone" name="phone" class="form-control" placeholder="+123456789" value="+123456789">
                </div>
                <!-- Password Update -->
                <div class="mb-4">
                    <label for="password" class="form-label">Assign Password</label>
                    <input type="text" id="password" name="password" class="form-control" placeholder="Enter password">
                </div>
                <!-- Update Button -->
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Save Admin
                    </button>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
</div>


<!-- Action Scripts -->
<script>
    function deleteAdmin(id) {
        if (confirm("Are you sure you want to delete this admin?")) {
            fetch(`/admin/delete_admin?id=${id}`, { method: "DELETE" })
                .then(response => response.json())
                .then(data => {
                    alert(data.message);
                    location.reload();
                })
                .catch(err => console.error(err));
        }
    }

    function revokeAccess(id) {
        if (confirm("Are you sure you want to revoke this admin's access?")) {
            fetch(`/admin/revoke_access?id=${id}`, { method: "POST" })
                .then(response => response.json())
                .then(data => {
                    alert(data.message);
                    location.reload();
                })
                .catch(err => console.error(err));
        }
    }
</script>

<%- include('./_layouts/footer') %>
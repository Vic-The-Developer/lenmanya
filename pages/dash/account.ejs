<%- include('./_layouts/header') %>


<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
        <%= errorMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>


<!-- Admin Profile Card -->
<div class="container">
    <div class="card card-profile bg-white">
        <h3 class="text-center text-primary mb-4">
            Admin Profile Information
        </h3>
        <form action="/admin/edit_profile/<%= currentAdmin ? currentAdmin.email : '' %>" method="post" enctype="application/x-www-form-urlencoded">
            <!-- Display Name -->
            <div class="mb-3">
                <label for="displayName" class="form-label">Display Name</label>
                <input type="text" id="displayName" name="displayName" class="form-control"
                       placeholder="Admin Name" value="<%= currentAdmin ? currentAdmin.displayName : '' %>">
            </div>
            <!--Role-->
            <div class="mb-3">
                <label for="role" class="form-label">Admin Role</label>
                <input type="text" id="role" name="role" class="form-control"
                       placeholder="Super or Admin" value="<%= currentAdmin ? currentAdmin.displayName : '' %>">
            </div>
            <!-- Email Address -->
            <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" id="email" name="email" class="form-control"
                       placeholder="admin@example.com" value="<%= currentAdmin ? currentAdmin.email : '' %>">
            </div>
            <!-- Phone Number -->
            <div class="mb-3">
                <label for="phone" class="form-label">Phone Number <small>(Optional)</small></label>
                <input type="text" id="phone" name="phone" class="phone form-control"
                       placeholder="07 or 011 or 010****" value="<%= currentAdmin ? currentAdmin.phone || '' : '' %>">
            </div>
            <!-- Password Update -->
            <div class="mb-4">
                <label for="password" class="form-label">Update Password</label>
                <input type="password" name="oldPass" class="form-control" placeholder="Enter old password">
                <input type="password" name="newPass" class="form-control mt-2" placeholder="Enter new password">
            </div>
            <!-- Update Button -->
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i> Update Profile
                </button>
                <a href="/admin/logout" class="btn btn-danger">
                    <i class="fa fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </form>
        <div style="margin-top: 40px; text-align: center;">
            <a href="#" class="btn btn-success" data-toggle="modal" data-target=".bd-example-modal-lg">Add New Admin</a>
        </div>
    </div>

    <h2 class="text-primary mb-4">Admin Accounts</h2>

    <!-- Admin Table -->
    <table class="table table-striped table-bordered mt-4">
        <thead class="thead-secondary">
            <tr>
                <th>#</th>
                <th>Display Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (admins && admins.length > 0) { %>
                <% admins.forEach((admin, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= admin.displayName %></td>
                        <td><%= admin.email %></td>
                        <td><%= admin.role || 'Admin' %></td>
                        <td>
                            <button type="submit" class="btn btn-danger btn-sm" onclick="deleteAdmin('<%= admin._id %>')">
                                <i class="fa fa-trash"></i> &nbsp; Delete
                            </button>
                            <button class="btn btn-warning btn-sm" onclick="revokeAccess('<%= admin._id %>')">
                                <i class="fa fa-ban"></i> &nbsp; Revoke Access
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="text-center">No administrators found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
    
</div>

<!-- Modal -->
<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Create New Admin</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <form action="/admin/new_admin" method="post" enctype="application/x-www-form-urlencoded">
                <!-- Display Name -->
                <div class="mb-3">
                    <label for="displayName" class="form-label">Display Name</label>
                    <input type="text" id="displayName" name="displayName" class="form-control" placeholder="Admin Name" required>
                </div>
                <!-- Email Address -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="admin@example.com" required>
                </div>
                <!-- Phone Number -->
                <div class="mb-3">
                    <label for="phone" class="form-label">Phone Number (Optional)</label>
                    <input type="text" id="phone" name="phone" class="phone form-control" placeholder="07 or 011 or 010****" required>
                </div>
                <!-- Password Update -->
                <div class="mb-4">
                    <label for="password" class="form-label">Assign Password</label>
                    <input type="text" id="password" name="password" class="form-control" placeholder="Enter password" required>
                </div>
                <!-- Update Button -->
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Save Admin
                    </button>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Use querySelectorAll to target all elements with class 'phone'
        const phoneInputs = document.querySelectorAll('.phone');
    
        // Loop through all phone inputs and attach the event listener
        phoneInputs.forEach(phoneInput => {
            phoneInput.addEventListener("blur", function () {
                let phoneNumber = phoneInput.value.trim();
        
                // Remove all non-digit characters except the leading "+"
                phoneNumber = phoneNumber.replace(/[^\d+]/g, "");
        
                // Handle phone numbers starting with +254 or 07/011/010
                if (phoneNumber.startsWith("+254")) {
                    phoneNumber = "254" + phoneNumber.substring(4); // Remove + and keep 254
                } else if (phoneNumber.startsWith("07") || phoneNumber.startsWith("011") || phoneNumber.startsWith("010")) {
                    phoneNumber = "254" + phoneNumber.substring(1); // Replace 07, 011, 010 with 254
                }
        
                // Ensure the phone number is exactly 12 digits
                if (/^254\d{9}$/.test(phoneNumber)) {
                    phoneInput.value = phoneNumber; // Set formatted number
                } else {
                    alert("Invalid phone number format. Use 07XXXXXXX, 011XXXXXXX, or 010XXXXXXX.");
                    phoneInput.value = ""; // Clear invalid input
                }
            });
    
            // Prevent form submission if the phone number is invalid
            const form = phoneInput.closest("form");
            form.addEventListener("submit", function (event) {
                const phoneNumber = phoneInput.value.trim();
                if (!/^254\d{9}$/.test(phoneNumber)) {
                    alert("Please enter a valid phone number in the correct format.");
                    event.preventDefault(); // Stop form submission
                }
            });
        });
    });
</script>


<!-- Action Scripts -->
<script>
    function deleteAdmin(id) {
        if (!id) {
            console.error("Package ID is missing");
            return;
        }
    
        if (confirm("Are you sure you want to delete this Admin?")) {
            const deleteButton = document.querySelector(`button[onclick="deleteAdmin('${id}')"]`);
            if (deleteButton) {
                deleteButton.disabled = true;
                deleteButton.innerHTML = '<i class="fa fa-spinner fa-spin"></i>'; // Show a spinner
            }
    
            fetch(`/admin/delete_admin?id=${id}`, { method: "DELETE" })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload(); // Reload the page to reflect changes
                    } else {
                        alert(data.message);
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert("An error occurred while deleting the admin. Please try again.");
                })
                .finally(() => {
                    if (deleteButton) {
                        deleteButton.disabled = false;
                        deleteButton.innerHTML = '<i class="fa fa-trash"></i>'; // Restore original icon
                    }
                });
        }
    }

    function revokeAccess(id) {
        if (!id) {
            console.error("Package ID is missing");
            return;
        }
    
        if (confirm("Are you sure you want to revoke the Admin?")) {
            const deleteButton = document.querySelector(`button[onclick="revokeAccess('${id}')"]`);
            if (deleteButton) {
                deleteButton.disabled = true;
                deleteButton.innerHTML = '<i class="fa fa-spinner fa-spin"></i>'; // Show a spinner
            }
    
            fetch(`/admin/revoke_access?id=${id}`, { method: "POST" })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload(); // Reload the page to reflect changes
                    } else {
                        alert(data.message);
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert("An error occurred while Revoking Admin. Please try again.");
                })
                .finally(() => {
                    if (deleteButton) {
                        deleteButton.disabled = false;
                        deleteButton.innerHTML = '<i class="fa fa-ban"></i>'; // Restore original icon
                    }
                });
        }
    }
</script>

<%- include('./_layouts/footer') %>
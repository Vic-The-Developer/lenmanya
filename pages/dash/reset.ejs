<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | Lenmanya Adventures</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- Favicon -->
    <link href="/img/lenmanya fav.png" rel="icon">
    <style>
        body {
            height: 100vh;
            background-color: #f8f9fa;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .login-container {
            background: #ffffff;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 400px;
        }
        .login-container h3 {
            margin-bottom: 20px;
            text-align: center;
            font-weight: 600;
            color: #333;
        }
        .forgot-link {
            text-decoration: none;
            color: #007bff;
        }
        .forgot-link:hover {
            text-decoration: underline;
        }
        .btn-login {
            background-color: #007bff;
            color: #fff;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <!-- Login Form Container -->
    <div class="login-container">
        <img src="/img/lenmanya new.png" alt="logo" width="240px" style="margin-bottom: 20px; margin-left: 30px;">
        <h3>Reset Password</h3>
        
        <% if (successMessage) { %>
            <div class="alert alert-success alert-dismissible fade show mt-5" role="alert">
                <%= successMessage %>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
            </div>
        <% } %>
        
        <% if (errorMessage) { %>
            <div class="alert alert-warning alert-dismissible fade show mt-5" role="alert">
                <%= errorMessage %>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
            </div>
        <% } %>

        <form action="/admin/reset" method="post" enctype="application/x-www-form-urlencoded">
            <!-- Email Input -->
            <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" required>
            </div>
            
            
            <!-- Login Button -->
            <button type="submit" class="btn btn-login w-100">
                <i class="fa fa-refresh me-2"></i> Send Reset Link
            </button>
        </form>
    </div>

    <!-- Bootstrap JS Bundle -->
    <!-- Bootstrap JS Bundle -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
</body>
</html>

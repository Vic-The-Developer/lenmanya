<%- include('./_layouts/header') %>

<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <%= errorMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<!-- Manage Blogs Page -->
<div class="container mt-5">

    <!-- Key Metrics Section -->
    <div class="row mb-4">
        <!-- Total Blog Posts -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-envelope"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <h5><%= totalBlogs %></h5>
                            <p>Total Blog Posts</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Draft Blogs -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-pencil-square-o"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <h5><%= draftBlogs %></h5>
                            <p>Draft</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Published Blogs -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-file-text"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <h5><%= publishedBlogs %></h5>
                            <p>Published</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    


    <div class="border"  style="padding: 20px;">
        <!-- Page Header -->
        <h2 class="text-primary">Manage Blogs</h2>
        <div class=" justify-content-between align-items-center mb-4" style="width: 80%;">
            
            <!-- Search and Filters -->
             <form action="/admin/filter_blogs" method="post">
              <div class="d-flex gap-2">
                <select class="form-control" name="category" id="category">
                    <option value="">Filter by Category</option>
                    <option value="Travel Tips">Travel</option>
                    <option value="Destinations">Destinations</option>
                    <option value="Lifestyle">Lifestyle</option>
                </select>
                <select class="form-control" name="status" id="status">
                    <option value="">Filter by Status</option>
                    <option value="Published">Published</option>
                    <option value="Draft">Draft</option>
                </select>
                <button class="btn btn-primary">
                  <i class="fa fa-search"></i>
                </button>
              </div>
             </form>
        </div>


        <!-- Blog List Table -->
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered text-center align-middle">
              <thead class="table-light">
                <tr>
                  <th>Blog Title</th>
                  <th>Category</th>
                  <th>Date Published</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (blogs && blogs.length > 0) { %>
                  <% blogs.forEach((blog) => { %>
                    <tr>
                      <td><%= blog.bTitle %></td>
                      <td><%= blog.category || 'N/A' %></td>
                      <td><%= blog.createdAt ? blog.createdAt.toDateString() : 'Not Published' %></td>
                      <td>
                        <% if (blog.status === 'Published') { %>
                          <span class="badge bg-success">Published</span>
                        <% } else { %>
                          <span class="badge bg-warning text-dark">Draft</span>
                        <% } %>
                      </td>
                      <td>
                        <div class="d-flex justify-content-center gap-2">
                          <!-- Edit Button -->
                          <button class="btn btn-sm btn-info" data-toggle="modal" data-target="#editBlogModal-<%= blog._id %>" title="Edit">
                            <i class="fa fa-edit"></i>
                          </button>
                          <!-- Delete Button -->
                          <form action="/admin/delete-blog/<%= blog._id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                              <i class="fa fa-trash"></i>
                            </button>
                          </form>
                          <!-- View Button -->
                          <a href="/blogs/view/<%= blog._id %>" class="btn btn-sm btn-primary" title="View">
                            <i class="fa fa-eye"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                    
                    <!-- Edit Blog Modal -->
                    <div class="modal fade" id="editBlogModal-<%= blog._id %>" tabindex="-1" role="dialog" aria-labelledby="editBlogModalLabel-<%= blog._id %>" aria-hidden="true">
                      <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h5 class="modal-title" id="editBlogModalLabel-<%= blog._id %>">Edit Blog: <%= blog.title %></h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                              <span aria-hidden="true">&times;</span>
                            </button>
                          </div>
                          <div class="modal-body">
                            <form action="/admin/edit-blog/<%= blog._id %>" method="post" enctype="multipart/form-data">
                              <!-- Blog Title -->
                              <div class="form-group mb-3">
                                <label for="title-<%= blog._id %>">Blog Title</label>
                                <input type="text" id="title-<%= blog._id %>" name="title" class="form-control" value="<%= blog.title %>" required>
                              </div>
          
                              <!-- Category -->
                              <div class="form-group mb-3">
                                <label for="category-<%= blog._id %>">Category</label>
                                <select id="category-<%= blog._id %>" name="category" class="form-control">
                                  <option value="Travel Tips" <%= blog.category === 'Travel Tips' ? 'selected' : '' %>>Travel Tips</option>
                                  <option value="Destinations" <%= blog.category === 'Destinations' ? 'selected' : '' %>>Destinations</option>
                                  <option value="Special Offers" <%= blog.category === 'Special Offers' ? 'selected' : '' %>>Special Offers</option>
                                </select>
                              </div>
          
                              <!-- Featured Image -->
                              <div class="form-group mb-3">
                                <label for="featuredImage-<%= blog._id %>">Featured Image</label>
                                <input type="file" id="featuredImage-<%= blog._id %>" name="featuredImage" class="form-control" accept="image/*">
                              </div>
          
                              <!-- Content -->
                              <div class="form-group mb-3">
                                <label for="content-<%= blog._id %>">Content</label>
                                <textarea id="content-<%= blog._id %>" name="content" class="form-control" rows="10"><%= blog.content %></textarea>
                              </div>
          
                              <!-- Status -->
                              <div class="form-group mb-3">
                                <label>Status</label><br>
                                <div class="form-check form-check-inline">
                                  <input class="form-check-input" type="radio" name="status" value="Draft" <%= blog.status === 'Draft' ? 'checked' : '' %>>
                                  <label class="form-check-label">Draft</label>
                                </div>
                                <div class="form-check form-check-inline">
                                  <input class="form-check-input" type="radio" name="status" value="Published" <%= blog.status === 'Published' ? 'checked' : '' %>>
                                  <label class="form-check-label">Published</label>
                                </div>
                              </div>
          
                              <!-- Action Buttons -->
                              <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save Changes</button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5">No blogs available.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
        </div>
        <!-- Pagination Controls -->
        <nav aria-label="Blog Pagination">
            <ul class="pagination justify-content-center">
            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                </li>
            <% } %>
            </ul>
        </nav>
    </div>
</div>



<script src="https://cdn.tiny.cloud/1/wz6upinpprryclrsrruprdr6wyrcdymnv8lx75xu8t7q5qa9/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    
    tinymce.init({
        selector: '#content', // Target your content textarea
        plugins: 'image link media lists code',
        toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | bullist numlist outdent indent | link image media | code',
        height: 500,
        width: 1100,
        images_upload_url: '/admin/upload_image', // Specify your new endpoint sending images
        automatic_uploads: true, // Enable automatic uploads
        file_picker_types: 'image',
        file_picker_callback: function (cb, value, meta) {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            
            input.onchange = function () {
                const file = this.files[0];
                const reader = new FileReader();
                
                reader.onload = function () {
                    const id = 'blobid' + new Date().getTime();
                    const blobCache = tinymce.activeEditor.editorUpload.blobCache;
                    const base64 = reader.result.split(',')[1];
                    const blobInfo = blobCache.create(id, file, base64);
                    blobCache.add(blobInfo);

                    cb(blobInfo.blobUri(), { title: file.name });
                };

                reader.readAsDataURL(file);
            };

            input.click();
        },
        content_style: "body { font-family:Helvetica,Arial,sans-serif; font-size:14px; margin-top:30px }",
    });


</script>

<script>
     document.querySelector('.btn-preview').addEventListener('click', function() {
        const title = document.getElementById('bTitle').value;
        const content = tinymce.get('content').getContent(); // Replace 'content' with your editor's actual ID if different

        if (title && content) {
            document.getElementById('previewContainer').innerHTML = `
                <h2>Preview:</h2>
                <h3>${title}</h3>
                <div>${content}</div>
            `;
            alert(`Preview:\n\nTitle: ${title}\n\nContent:\n${content}`);
        } else {
            alert("Please enter both title and content to preview.");
        }
    });
</script>


<%- include('./_layouts/footer') %>
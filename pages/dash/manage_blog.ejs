<%- include('./_layouts/header') %>

<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<!-- Manage Blogs Page -->
<div class="container mt-5">

    <!-- Key Metrics Section -->
    <div class="row mb-4">
        <!-- Total Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <!-- Left Column -->
                    <div class="col-4 icon-col">
                        <i class="fa fa-envelope"></i>
                    </div>
                    <!-- Right Column -->
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5>123</h5>
                                </div>
                                <div class="col-12">
                                    <p>Total Blog Posts</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Unresolved Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <!-- Left Column -->
                    <div class="col-4 icon-col">
                        <i class="fa fa-pencil-square-o"></i>
                    </div>
                    <!-- Right Column -->
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5>45</h5>
                                </div>
                                <div class="col-12">
                                    <p>Draft</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Resolved Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <!-- Left Column -->
                    <div class="col-4 icon-col">
                        <i class="fa fa-file-text"></i>
                    </div>
                    <!-- Right Column -->
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5>67</h5>
                                </div>
                                <div class="col-12">
                                    <p>Published</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="border"  style="padding: 20px;">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary">Manage Blogs</h2>
            <!-- Search and Filters -->
            <div class="d-flex gap-2">
                <form action="/admin/filter_blogs" method="post">
                    <select class="form-select" name="category" id="category">
                        <option value="">Filter by Category</option>
                        <option value="Travel">Travel</option>
                        <option value="Guides">Guides</option>
                        <option value="News">News</option>
                    </select>
                    <select class="form-select" name="status" id="status">
                        <option value="">Filter by Status</option>
                        <option value="Published">Published</option>
                        <option value="Draft">Draft</option>
                    </select>
                    <button class="btn btn-primary">Search</button>
                </form>
            </div>
        </div>


        <!-- Blog List Table -->
        <div class="table-responsive">
            <table class="table table-hover table-bordered text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Blog Title</th>
                        <th>Category</th>
                        <th>Date Published</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Blog Row 1 -->
                    <tr>
                        <td>Top 10 Safari Destinations</td>
                        <td>Travel</td>
                        <td>2024-06-27</td>
                        <td><span class="badge bg-success">Published</span></td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <button class="btn btn-sm btn-info" data-toggle="modal" data-target=".bd-example-modal-lg" title="Edit"><i class="fa fa-edit"></i></button>
                                <button class="btn btn-sm btn-danger" title="Delete"><i class="fa fa-trash"></i></button>
                                <a href="#" class="btn btn-sm btn-primary" title="View"><i class="fa fa-eye"></i></a>
                            </div>
                        </td>
                    </tr>
                    <!-- Blog Row 2 -->
                    <tr>
                        <td>A Beginner's Guide to Safari Tours</td>
                        <td>Guides</td>
                        <td>2024-06-25</td>
                        <td><span class="badge bg-warning text-dark">Draft</span></td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <button class="btn btn-sm btn-info" title="Edit"><i class="fa fa-edit"></i></button>
                                <button class="btn btn-sm btn-danger" title="Delete"><i class="fa fa-trash"></i></button>
                                <a href="#" class="btn btn-sm btn-primary" title="View"><i class="fa fa-eye"></i></a>
                            </div>
                        </td>
                    </tr>
                    <!-- Add More Rows Here -->
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Edit Blog: (title)</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <form action="/admin/create_blog" method="post" enctype="multipart/form-data">
                <!-- Blog Title Row -->
                <div class="form-row">
                    <label for="title">Blog Title</label>
                    <input type="text" id="bTitle" name="bTitle" class="form-control" placeholder="Enter blog title" required>
                </div>
        
                <!-- Category Row -->
                <div class="form-row">
                    <label for="category">Category</label>
                    <select id="category"  class="form-control" name="category" required>
                        <option value="">-- Select Category --</option>
                        <option value="Travel Tips">Travel Tips</option>
                        <option value="Destinations">Destinations</option>
                        <option value="Special Offers">Special Offers</option>
                    </select>
                </div>

                <div class="form-row">current image preview</div>
        
                <!-- Featured Image Row -->
                <div class="form-row">
                    <label for="featuredImage">Featured Image/Thumbnail</label>
                    <input type="file" id="featuredImage" name="featuredImage" class="form-control" accept="image/*">
                </div>
        
                <!-- Blog Content Row -->
                <div class="form-row">
                    <label for="content">Blog Content</label>
                </div>
        
                <div class="form-row">
                    <textarea id="content" name="content" class="form-control" rows="14"></textarea>
                </div>
        
                <!-- SEO Metadata Section -->
                <h5 class="mb-3 mt-4">SEO Metadata</h5>
                <div class="form-row">
                    <label for="metaTitle">Meta Title</label>
                    <input type="text" id="metaTitle" name="metaTitle" class="form-control" placeholder="Enter meta title" required>
                </div>
                <div class="form-row">
                    <label for="metaDescription">Meta Description</label>
                    <input type="text" id="metaDescription" name="metaDescription" class="form-control" placeholder="Enter meta description" required>
                </div>
                <div class="form-row">
                    <label for="keywords">Keywords</label>
                    <input type="text" id="keywords" name="keywords" class="form-control" placeholder="E.g., Travel, Safari, Offers">
                </div>
        
                <!-- Blog Status -->
                <div class="form-row">
                    <label class="form-label mb-2">Status:</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="status" id="draft" value="Draft" checked>
                        <label class="form-check-label" for="draft">Draft</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="status" id="published" value="Published">
                        <label class="form-check-label" for="published">Publish</label>
                    </div>
                </div>
        
                <!-- Action Buttons -->
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Update Blog</button>
                    <button type="button" class="btn btn-primary btn-preview"><i class="fa fa-eye"></i> Preview</button>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
</div>



<script src="https://cdn.tiny.cloud/1/wz6upinpprryclrsrruprdr6wyrcdymnv8lx75xu8t7q5qa9/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    
    tinymce.init({
        selector: '#content', // Target your content textarea
        plugins: 'image link media lists code',
        toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | bullist numlist outdent indent | link image media | code',
        height: 500,
        width: 1100,
        images_upload_url: '/admin/upload_image', // Specify your new endpoint sending images
        automatic_uploads: true, // Enable automatic uploads
        file_picker_types: 'image',
        file_picker_callback: function (cb, value, meta) {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            
            input.onchange = function () {
                const file = this.files[0];
                const reader = new FileReader();
                
                reader.onload = function () {
                    const id = 'blobid' + new Date().getTime();
                    const blobCache = tinymce.activeEditor.editorUpload.blobCache;
                    const base64 = reader.result.split(',')[1];
                    const blobInfo = blobCache.create(id, file, base64);
                    blobCache.add(blobInfo);

                    cb(blobInfo.blobUri(), { title: file.name });
                };

                reader.readAsDataURL(file);
            };

            input.click();
        },
        content_style: "body { font-family:Helvetica,Arial,sans-serif; font-size:14px; margin-top:30px }",
    });


</script>

<script>
     document.querySelector('.btn-preview').addEventListener('click', function() {
        const title = document.getElementById('bTitle').value;
        const content = tinymce.get('content').getContent(); // Replace 'content' with your editor's actual ID if different

        if (title && content) {
            document.getElementById('previewContainer').innerHTML = `
                <h2>Preview:</h2>
                <h3>${title}</h3>
                <div>${content}</div>
            `;
            alert(`Preview:\n\nTitle: ${title}\n\nContent:\n${content}`);
        } else {
            alert("Please enter both title and content to preview.");
        }
    });
</script>


<%- include('./_layouts/footer') %>
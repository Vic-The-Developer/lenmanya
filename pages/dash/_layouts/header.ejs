<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>

    <!-- Favicons -->
    <link href="/img/lenmanya fav.png" rel="icon">
</head>

<body>
    <!-- Dash Navbar Top -->
    <nav class="navbar navbar-light navbar-static-top dash-navbar-top nb-visible">
        <button class="nb-btn-toggle">
            <span class="fa fa-bars"></span>
        </button>
    </nav>

    <!-- Dash Navbar Left -->
    <div class="dash-navbar-left nb-visible">
        <a class="navbar-brand" href="/admin/dash">
            <img src="/img/logo-nobg.png" alt="Logo" width="250px">
        </a>
    
        <p class="nb-nav-title">Home</p>
        <ul class="nb-nav">
            <li class="<%= currentPath === '/admin/dash' ? 'active' : '' %>">
                <a href="/admin/dash">
                    <span class="fa fa-bar-chart nb-link-icon"></span>
                    <span class="nb-link-text">Overview</span>
                </a>
            </li>
            <li class="<%= currentPath === '/admin/manage-Enquiries' ? 'active' : '' %>">
                <a href="/admin/manage-Enquiries">
                    <span class="fa fa-envelope nb-link-icon"></span>
                    <span class="nb-link-text">Enquiries</span>
                </a>
            </li>
            <li class="<%= currentPath === '/admin/packages' ? 'active' : '' %>">
                <a href="/admin/packages">
                    <span class="fa fa-folder-open nb-link-icon"></span>
                    <span class="nb-link-text">Manage Packages</span>
                </a>
            </li>
            <li class="<%= currentPath === '/admin/manage-blogs' ? 'active' : '' %>">
                <a href="/admin/manage-blogs">
                    <span class="fa fa-window-restore nb-link-icon"></span>
                    <span class="nb-link-text">Manage Blogs</span>
                </a>
            </li>
            <li class="<%= currentPath === '/admin/create-blog' ? 'active' : '' %>">
                <a href="/admin/create-blog">
                    <span class="fa fa-file-image-o nb-link-icon"></span>
                    <span class="nb-link-text">Create Blog</span>
                </a>
            </li>
            <li class="<%= currentPath === '/admin/account' ? 'active' : '' %>">
                <a href="/admin/account">
                    <span class="fa fa-user-circle nb-link-icon"></span>
                    <span class="nb-link-text">Account</span>
                </a>
            </li>
        </ul>
        <p class="nb-nav-title">Site Map</p>
        <ul class="nb-nav">
            <li class="<%= currentPath === '/' ? 'active' : '' %>">
                <a href="/">
                    <span class="fa fa-backward nb-link-icon"></span>
                    <span class="nb-link-text">Main Page</span>
                </a>
            </li>
        </ul>
    </div>
     <!-- /.dash-navbar-left -->
      <div class="contBlog">

      




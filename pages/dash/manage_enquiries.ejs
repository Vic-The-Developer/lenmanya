<%- include('./_layouts/header') %>

<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<div class="container mt-5">
    <!-- Page Title -->
    <div class="mb-4 text-center">
        <h2 class="text-primary">Manage Client Enquiries</h2>
        <p>View, manage, and respond to enquiries submitted by clients.</p>
    </div>

    <!-- Key Metrics Section -->
    <div class="row mb-4">
        <!-- Total Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-envelope"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= totalEnquiries %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Total Enquiries</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Unresolved Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-files-o"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= unresolvedEnquiries %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Unresolved</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Resolved Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-check-square-o"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= resolvedEnquiries %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Resolved</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>  

    <!-- Filter and Search Section -->
    <div class="filter-section mb-4">
        <form class="row g-3" action="/admin/filter_enquiries" method="post" enctype="application/x-www-form-urlencoded">
            <div class="col-md-6">
                <input type="text" class="form-control" placeholder="Search by Whatsapp number: i.e. 0712345678" name="Whatsapp" id="Whatsapp">
            </div>
            
            <div class="col-md-3">
                <select class="form-select" name="status-filter" id="status-filter">
                    <option value="">Filter by Status</option>
                    <option value="pending">Pending</option>
                    <option value="resolved">Resolved</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="button" class="btn btn-primary"><i class="fa fa-filter"></i> Filter</button>
            </div>
        </form>
    </div>

    <!-- Enquiry Table -->
    <div class="card">
        <div class="card-body">
            <table class="table table-hover table-bordered text-center">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Destination</th>
                        <th>WhatsApp No.</th>
                        <th>Date Submitted</th>
                        <th>Adults</th>
                        <th>Children</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (enquiries.length > 0) { %>
                        <% enquiries.forEach(enquiry => { %>
                            <tr>
                                <td><%= enquiry.name || '-' %></td>
                                <td><%= enquiry.destination || '-' %></td>
                                <td><%= enquiry.whatsapp || '-' %></td>
                                <td><%= enquiry.createdAt.toISOString().split('T')[0] %></td>
                                <td><%= enquiry.adults || '-' %></td>
                                <td><%= enquiry.children || '-' %></td>
                                <td>
                                    <% if (enquiry.status === 'Resolved') { %>
                                        <span class="badge bg-success">Resolved</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <% if (enquiry.status !== 'Resolved') { %>
                                            <form action="/admin/enquiries/<%= enquiry._id %>/resolve" method="POST">
                                                <button type="submit" class="btn btn-sm btn-primary" title="Mark as Resolved">
                                                    <i class="fa fa-check"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <button class="btn btn-sm btn-secondary" disabled>
                                                <i class="fa fa-check"></i>
                                            </button>
                                        <% } %>
                                        <a href="https://wa.me/<%= enquiry.whatsapp %>" target="_blank" class="btn btn-sm btn-success" title="Respond via WhatsApp">
                                            <i class="fa fa-whatsapp" style="color: white;"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center">No enquiries available</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
    
            <!-- Pagination Controls -->
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                    <% if (currentPage > 1) { %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/manage-Enquiries/<%= currentPage - 1 %>">Previous</a>
                        </li>
                    <% } %>
    
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="/admin/manage-Enquiries/<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
    
                    <% if (currentPage < totalPages) { %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/manage-Enquiries/<%= currentPage + 1 %>">Next</a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </div>
    
    

    <!-- Export Buttons -->
    <div class="text-end mt-3">
        <button class="btn btn-outline-primary"><i class="fa fa-file-excel"></i> Export to Excel</button>
        <button class="btn btn-outline-danger"><i class="fa fa-file-pdf"></i> Export to PDF</button>
    </div>
</div>


<%- include('./_layouts/footer') %>
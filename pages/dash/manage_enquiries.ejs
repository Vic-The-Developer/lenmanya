<%- include('./_layouts/header') %>

<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show mt-5" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-warning alert-dismissible fade show mt-5" role="alert">
        <%= errorMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<div class="container mt-5">
    <!-- Page Title -->
    <div class="mb-4 text-center">
        <h2 class="text-primary">Manage Client Enquiries</h2>
        <p>View, manage, and respond to enquiries submitted by clients.</p>
    </div>

    <!-- Key Metrics Section -->
    <div class="row mb-4">
        <!-- Total Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-envelope"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= totalEnquiries %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Total Enquiries</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Unresolved Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-files-o"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= unresolvedEnquiries %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Unresolved</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Resolved Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-check-square-o"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= resolvedEnquiries %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Resolved</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>  

    <!-- Filter and Search Section -->
    <div class="filter-section mb-4">
        <form class="row g-3" action="/admin/filter_enquiries" method="post" enctype="application/x-www-form-urlencoded">
            <div class="col-md-6">
                <input type="text" class="form-control" placeholder="Whatsapp number: i.e. 07 or 011 or 010***" name="whatsapp" id="whatsapp" required>
            </div>
            
            <div class="col-md-3">
                <select class="form-control" name="status-filter" id="status-filter" required>
                    <option value="">Filter by Status</option>
                    <option value="pending">Pending</option>
                    <option value="resolved">Resolved</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn btn-primary"><i class="fa fa-filter"></i> Filter</button>
            </div>
        </form>
    </div>

    <!-- Enquiry Table -->
    <div class="card">
        <div class="card-body">
            <table class="table table-hover table-bordered text-center">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Destination</th>
                        <th>WhatsApp No.</th>
                        <th>Date of Travel</th>
                        <th>Date Submitted</th>
                        <th>Adults</th>
                        <th>Children</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (enquiries.length > 0) { %>
                        <% enquiries.forEach(enquiry => { %>
                            <tr>
                                <td><%= enquiry.fname || '-' %></td>
                                <td><%= enquiry.destination || '-' %></td>
                                <td><%= enquiry.whatsapp || '-' %></td>
                                <td><%= enquiry.date1.toISOString().split('T')[0] %></td>
                                <td><%= enquiry.createdAt.toISOString().split('T')[0] %></td>
                                <td><%= enquiry.adults || '-' %></td>
                                <td><%= enquiry.children || '-' %></td>
                                <td>
                                    <% if (enquiry.status === 'resolved') { %>
                                        <span class="badge bg-success">Resolved</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <% if (enquiry.status !== 'resolved') { %>
                                            <form action="/admin/resolve_enquiry?id=<%= enquiry._id %>" method="POST">
                                                <button type="submit" class="btn btn-sm btn-primary" title="Mark as Resolved">
                                                    <i class="fa fa-check"></i>
                                                </button>
                                            </form>
                                            
                                        <% } else { %>
                                            <button class="btn btn-sm btn-secondary" disabled>
                                                <i class="fa fa-check"></i>
                                            </button>
                                        <% } %>
                                        <a href="https://api.whatsapp.com/send?phone=<%= enquiry.whatsapp %>" target="_blank" class="btn btn-sm btn-success" title="Respond via WhatsApp">
                                            <i class="fa fa-whatsapp" style="color: white;"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center">No enquiries available</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
    
            <!-- Pagination Controls -->
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                    <% if (currentPage > 1) { %>
                        <!-- Previous button -->
                        <li class="page-item">
                            <a class="page-link" href="/admin/manage-Enquiries/<%= currentPage - 1 %>">Previous</a>
                        </li>
                    <% } %>
            
                    <!-- First Page -->
                    <% if (currentPage > 3) { %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/manage-Enquiries/1">1</a>
                        </li>
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    <% } %>
            
                    <!-- Pages Around Current Page -->
                    <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="/admin/manage-Enquiries/<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
            
                    <!-- Last Page -->
                    <% if (currentPage < totalPages - 2) { %>
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                        <li class="page-item">
                            <a class="page-link" href="/admin/manage-Enquiries/<%= totalPages %>"><%= totalPages %></a>
                        </li>
                    <% } %>
            
                    <% if (currentPage < totalPages) { %>
                        <!-- Next button -->
                        <li class="page-item">
                            <a class="page-link" href="/admin/manage-Enquiries/<%= currentPage + 1 %>">Next</a>
                        </li>
                    <% } %>
                </ul>
            </nav>            
        </div>
    </div>
    
    

    <!-- Export Buttons -->
    <div class="text-end mt-3">
        <button class="btn btn-outline-primary excelExport"><i class="fa fa-file-excel"></i> Export to Excel</button>
        <button class="btn btn-outline-danger pdfExport"><i class="fa fa-file-pdf"></i> Export to PDF</button>
    </div>
</div>

<script>
    document.querySelector('.excelExport').addEventListener('click', () => {
        window.location.href = '/admin/export/excel';
    });

    document.querySelector('.pdfExport').addEventListener('click', () => {
        window.location.href = '/admin/export/pdf';
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const phoneInput = document.getElementById("whatsapp");
    
        phoneInput.addEventListener("blur", function () {
            let phoneNumber = phoneInput.value.trim();
    
            // Remove all non-digit characters except the leading "+"
            phoneNumber = phoneNumber.replace(/[^\d+]/g, "");
    
            // Handle phone numbers starting with +254 or 07/011/010
            if (phoneNumber.startsWith("+254")) {
                phoneNumber = "254" + phoneNumber.substring(4); // Remove + and keep 254
            } else if (phoneNumber.startsWith("07") || phoneNumber.startsWith("011") || phoneNumber.startsWith("010")) {
                phoneNumber = "254" + phoneNumber.substring(1); // Replace 07, 011, 010 with 254
            }
    
            // Ensure the phone number is exactly 12 digits
            if (/^254\d{9}$/.test(phoneNumber)) {
                phoneInput.value = phoneNumber; // Set formatted number
            } else {
                alert("Invalid phone number format. Use 07XXXXXXX, 011XXXXXXX, or 010XXXXXXX.");
                phoneInput.value = ""; // Clear invalid input
            }
        });
    
        // Prevent form submission if the phone number is invalid
        const form = phoneInput.closest("form");
        form.addEventListener("submit", function (event) {
            const phoneNumber = phoneInput.value.trim();
            if (!/^254\d{9}$/.test(phoneNumber)) {
                alert("Please enter a valid phone number in the correct format.");
                event.preventDefault(); // Stop form submission
            }
        });
    });
</script>

<%- include('./_layouts/footer') %>
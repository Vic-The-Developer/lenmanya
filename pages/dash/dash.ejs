<%- include('./_layouts/header') %>


<!-- Main Container -->
<div class="container-fluid py-4">
    <% if (successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show mt-5" role="alert">
            <%= successMessage %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
        </div>
    <% } %>
    
    <% if (errorMessage) { %>
        <div class="alert alert-warning alert-dismissible fade show mt-5" role="alert">
            <%= errorMessage %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
        </div>
    <% } %>
    
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Admin Dashboard</h2>
        <a href="/admin/create-blog" class="btn btn-warning">Create Blog</a>
    </div>

    <!-- Key Metrics Section -->
    <div class="row mb-4">
        <!-- Total Enquiries -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-envelope"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= totalEnquiries %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Total Enquiries</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Published Blogs -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-file-text"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= publishedBlogs %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Published Blogs</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Draft Blogs -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card card-metric">
                <div class="row w-100">
                    <div class="col-4 icon-col">
                        <i class="fa fa-map-marker"></i>
                    </div>
                    <div class="col-8">
                        <div class="cardRight">
                            <div class="row">
                                <div class="col-12">
                                    <h5><%= totalPackages %></h5>
                                </div>
                                <div class="col-12">
                                    <p>Total Packages</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent Enquiries Section -->
    <div class="mb-5 border" style="padding: 20px;">
        <h4 class="section-title">Recent Enquiries</h4>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>WhatsApp No.</th>
                        <th>Destination</th>
                        <th>Date of Travel</th>
                        <th>Date Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentEnquiries.length > 0) { %>
                        <% recentEnquiries.forEach(enquiry => { %>
                            <tr>
                                <td><%= enquiry.fname || '-' %></td>
                                <td><%= enquiry.whatsapp || '-' %></td>
                                <td><%= enquiry.destination || '-' %></td>
                                <td><%= enquiry.date1.toISOString().split('T')[0] || '-' %></td>
                                <td><%= enquiry.createdAt.toISOString().split('T')[0] || '-' %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center">No enquiries available</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <div class="inquiryBtn">
            <a href="/admin/manage-Enquiries/1" class="btn btn-success">View More</a>
        </div>
    </div>
    

    <!-- Blog Summary Section -->
    <div>
        <h4 class="section-title">Latest Blogs</h4>
        <div class="row">
            <% if (latestBlogs.length > 0) { %>
                <% latestBlogs.forEach(blog => { %>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title"><%= blog.bTitle || '-' %></h5>
                                <p class="card-text"><%= blog.metaDescription || '-' %></p>
                                <a href="/blog/<%= blog._id %>" class="btn btn-primary btn-sm">View Blog</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12">
                    <p class="text-center">No blogs available</p>
                </div>
            <% } %>
        </div>
    </div>
    
</div>



<%- include('./_layouts/footer') %>
<%- include('./_layouts/header') %>


<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-warning alert-dismissible fade show mt-4" role="alert">
        <%= errorMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<!-- Main Content -->
<div class="container-fluid py-4">
    <div class="container">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Manage Travel Packages</h2>
            <a href="#" class="btn btn-primary" data-toggle="modal" data-target=".bd-package-modal-lg">
                <i class="fa fa-plus me-2"></i>Add New Package
            </a>
        </div>

        <!-- Key Metrics Section -->
        <div class="row mb-4">
            <!-- Total Packages -->
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card card-metric">
                    <div class="row w-100">
                        <div class="col-4 icon-col"><i class="fa fa-folder"></i></div>
                        <div class="col-8">
                            <div class="cardRight">
                                <h5><%= totalPackages || 0 %></h5>
                                <p>Total Packages</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Pending Packages -->
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card card-metric">
                    <div class="row w-100">
                        <div class="col-4 icon-col"><i class="fa fa-hourglass-half"></i></div>
                        <div class="col-8">
                            <div class="cardRight">
                                <h5><%= pendingPackages || 0 %></h5>
                                <p>Pending</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Active Packages -->
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card card-metric">
                    <div class="row w-100">
                        <div class="col-4 icon-col"><i class="fa fa-check-square-o"></i></div>
                        <div class="col-8">
                            <div class="cardRight">
                                <h5><%= activePackages || 0 %></h5>
                                <p>Active</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        

        <!-- Table Container -->
        <div class="table-container">
            <!-- Filter and Search Section -->
            <div class="mb-4">
                <form class="row g-3" action="/admin/filter_package" method="post" enctype="application/x-www-form-urlencoded">
                    <div class="col-md-8">
                        <input type="text" name="search" class="form-control" placeholder="Search by location..." required>
                    </div>
                    <div class="col-md-4 text-end">
                        <button class="btn btn-success" type="submit">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        
            <!-- Packages Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover text-center">
                    <thead class="table-primary">
                        <tr>
                            <th>#</th>
                            <th>Package Name</th>
                            <th>Location</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Date Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (packages.length > 0) { %>
                            <% packages.forEach((pkg, index) => { %>
                                <tr>
                                    <td><%= (currentPage - 1) * 10 + index + 1 %></td>
                                    <td><%= pkg.pTitle || '-' %></td>
                                    <td><%= pkg.pLoc || '-' %></td>
                                    <td><%= pkg.price || '0.00' %></td>
                                    <td>
                                        <% if (pkg.stat === 'active') { %>
                                            <span class="badge bg-success" style="color: white;">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark" style="color: white;">Pending</span>
                                        <% } %>
                                    </td>
                                    <td><%= pkg.createdAt.toISOString().split('T')[0] %></td>
                                    <td>
                                        <a href="#" class="btn btn-primary" title="Edit" data-toggle="modal" data-target="#editModal-<%= pkg._id %>"><i class="fa fa-edit"></i></a>
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="deletePackage('<%= pkg._id %>')">
                                            <i class="fa fa-trash"></i> &nbsp; Delete
                                        </button>
                                        <a href="#" class="btn btn-success" title="View Details" data-toggle="modal" data-target="#detailModal-<%= pkg._id %>"><i class="fa fa-eye"></i></a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center">No packages available</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        
            <!-- Pagination Controls -->
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                    <% if (currentPage > 1) { %>
                        <!-- Previous button -->
                        <li class="page-item">
                            <a class="page-link" href="/admin/packages/<%= currentPage - 1 %>">Previous</a>
                        </li>
                    <% } %>
            
                    <!-- First Page -->
                    <% if (currentPage > 3) { %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/packages/1">1</a>
                        </li>
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    <% } %>
            
                    <!-- Pages Around Current Page -->
                    <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="/admin/packages/<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
            
                    <!-- Last Page -->
                    <% if (currentPage < totalPages - 2) { %>
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                        <li class="page-item">
                            <a class="page-link" href="/admin/packages/<%= totalPages %>"><%= totalPages %></a>
                        </li>
                    <% } %>
            
                    <% if (currentPage < totalPages) { %>
                        <!-- Next button -->
                        <li class="page-item">
                            <a class="page-link" href="/admin/packages/<%= currentPage + 1 %>">Next</a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        </div>
        
    </div>
</div>

<!-- Edit package Modal -->
<% packages.forEach((pkg) => { %>
    <!-- Edit Package Modal for <%= pkg.name %> -->
    <div class="modal fade" id="editModal-<%= pkg._id %>" tabindex="-1" role="dialog" aria-labelledby="editModalLabel-<%= pkg._id %>" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel-<%= pkg._id %>">
                        Edit Package: <%= pkg.pTitle %>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form action="/admin/edit_package?id=<%= pkg._id %>" method="post" enctype="application/x-www-form-urlencoded">
    
                        <!-- Package Title -->
                        <div class="mb-3">
                            <label for="pTitle-<%= pkg._id %>" class="form-label">Package Title</label>
                            <input type="text" id="pTitle-<%= pkg._id %>" name="pTitle" class="form-control" value="<%= pkg.pTitle %>">
                        </div>
    
                        <!-- Location -->
                        <div class="mb-3">
                            <label for="pLoc-<%= pkg._id %>" class="form-label">Location</label>
                            <input type="text" id="pLoc-<%= pkg._id %>" name="pLoc" class="form-control" value="<%= pkg.pLoc %>">
                        </div>
    
                        <!-- Days -->
                        <div class="mb-3">
                            <label for="pDays-<%= pkg._id %>" class="form-label">Days</label>
                            <input type="number" id="pDays-<%= pkg._id %>" name="pDays" class="form-control" value="<%= pkg.pDays %>">
                        </div>
    
                        <!-- Price -->
                        <div class="mb-3">
                            <label for="price-<%= pkg._id %>" class="form-label">Cost</label>
                            <input type="text" id="price-<%= pkg._id %>" name="price" class="form-control" value="<%= pkg.price %>">
                        </div>
    
                        <!-- Description -->
                        <div class="mb-3">
                            <label for="description-<%= pkg._id %>" class="form-label">Description <small>(not editable)</small></label>
                            <textarea name="description" class="form-control" id="description-<%= pkg._id %>" rows="6" readonly><%= pkg.description %></textarea>
                        </div>
    
                        <!-- Rating -->
                        <div class="mb-3">
                            <label for="rating-<%= pkg._id %>" class="form-label">Rating</label>
                            <input type="text" id="rating-<%= pkg._id %>" name="rating" class="form-control" value="<%= pkg.pRating %>">
                        </div>

                        <!-- Blog Status -->
                        <div class="mb-3">
                            <label class="form-label mb-2">Status:</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="stat" id="active" value="active" checked>
                                <label class="form-check-label" for="draft">Active</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="stat" id="pending" value="pending">
                                <label class="form-check-label" for="published">Pending</label>
                            </div>
                        </div>
    
                        <!-- Update Button -->
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Update Package
                            </button>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
<% }); %>
    
<!--Details Modal-->
<% packages.forEach((pkg) => { %>
    <!-- Package Details Modal for <%= pkg.pTitle %> -->
    <div class="modal fade" id="detailModal-<%= pkg._id %>" tabindex="-1" role="dialog" aria-labelledby="detailModalLabel-<%= pkg._id %>" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title" id="editModalLabel-<%= pkg._id %>">
                        <b>Package Details for:</b> <%= pkg.pTitle %>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div><b>Package Title:</b> <%= pkg.pTitle %> </div>
                    </div>

                    <div class="mb-3">
                        <h5>Images</h5>
                        <% pkg.pImages.map((img, index) => { %>
                            <img src="/uploads<%= img %>" alt="Package Image" style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #ddd; border-radius: 5px;">
                        <% }); %>
                    </div>

                    <div class="mb-3">
                        <h5>Description: </h5> <br>
                        <div id="desc-<%= pkg._id %>"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
<% }); %>


<!-- Create package Modal -->
<div class="modal fade bd-package-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Create a New Package</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <form action="/admin/packages_add" method="post" enctype="multipart/form-data">
                <!-- Display Name -->
                <div class="mb-3">
                    <label for="pTitle" class="form-label">Package Title</label>
                    <input type="text" id="pTitle" name="pTitle" class="form-control" placeholder="Enter title">
                </div>
                <!-- Location -->
                <div class="mb-3">
                    <label for="pLoc" class="form-label">Location</label>
                    <input type="text" id="pLoc" name="pLoc" class="form-control" placeholder="Enter Location">
                </div>
                <!-- Number of Days -->
                <div class="mb-3">
                    <label for="pDays" class="form-label">Days</label>
                    <input type="number" id="pDays" name="pDays" class="form-control" placeholder="Enter no of Days">
                </div>
                <!-- Price -->
                <div class="mb-3">
                    <label for="price" class="form-label">Cost</label>
                    <input type="text" id="price" name="price" class="form-control" placeholder="Enter total cost i.e. Ksh27,000 or $300">
                </div>
                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                </div>
                <div class="mb-3">
                    <textarea name="description" class="form-control" id="description" rows="6">
                        
                    </textarea>
                </div>
                <!-- Rating -->
                <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="number" id="pRating" name="pRating" class="form-control" placeholder="E.g. 4.9">
                </div>
                <!-- Images -->
                <div class="mb-3">
                    <label for="pImage" class="form-label">Upload upto 5 images</label>
                    <input type="file" name="pImages" id="pImages" class="form-control" accept="" multiple>
                </div>
                <div style="margin: 30px 0;">
                    <h5>Images Preview</h5>
                    <div id="imagePreview" style="display: flex; gap: 10px; flex-wrap: wrap;"></div>
                </div>
                
                <!-- Update Button -->
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Create Package
                    </button>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
</div>

<script>
    // Assume `packages` is dynamically passed from the server as an array of package objects
    const packages = <%- packages2 %>;

    console.log('Packages:', packages[0]);

    // Function to parse a string of HTML into DOM content
    const stringToHTML = string => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(string, 'text/html');
        // console.log('Parsed Document Body InnerHTML:', doc.body.innerHTML); // Debugging
        return doc.body.innerHTML; // Return the entire body content as innerHTML
    };

    // Function to populate the description div with parsed HTML
    function populateDiv(pkgId, description) {
        const container = document.getElementById(`desc-${pkgId}`);
        console.log('Container:', container);

        if (container) {
            const htmlContent = stringToHTML(description);
            console.log('Parsed HTML Content:', htmlContent);

            if (htmlContent) {
                // Directly set innerHTML to the container
                container.innerHTML = htmlContent;
            } else {
                console.warn(`HTML content for package ${pkgId} is null or undefined.`);
            }
        } else {
            console.warn(`Container with ID description-${pkgId} not found.`);
        }
    }

    // Loop through all packages and populate their description divs
    packages.forEach(pkg => {
        if (pkg._id && pkg.description) {
            populateDiv(pkg._id, pkg.description);
        } else {
            console.warn(`Package ${pkg._id} is missing a description.`);
        }
    });
</script>






<script>
    function deletePackage(id) {
        if (confirm("Are you sure you want to delete this package?")) {
            fetch(`/admin/delete_package?id=${id}`, { method: "DELETE" })
                .then(response => response.json())
                .then(data => {
                    alert(data.message);
                    location.reload();
                })
                .catch(err => console.error(err));
        }
    }
</script>

<script src="https://cdn.tiny.cloud/1/wz6upinpprryclrsrruprdr6wyrcdymnv8lx75xu8t7q5qa9/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    
    tinymce.init({
        selector: '#description', // Target your content textarea
        plugins: 'image link media lists code',
        toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | bullist numlist outdent indent | link | code',
        height: 500,
        
        content_style: "body { font-family:Helvetica,Arial,sans-serif; font-size:14px; margin-top:30px }",
    });

</script>


<script>
    document.getElementById('pImages').addEventListener('change', function(event) {
        const previewContainer = document.getElementById('imagePreview');
        previewContainer.innerHTML = ''; // Clear previous previews

        const files = event.target.files;

        if (files.length > 5) {
            alert('You can upload a maximum of 5 images.');
            event.target.value = ''; // Reset file input
            return;
        }

        Array.from(files).forEach(file => {
            if (!file.type.startsWith('image/')) {
                alert('Only image files are allowed.');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.width = '100px';
                img.style.height = '100px';
                img.style.objectFit = 'cover';
                img.style.border = '1px solid #ddd';
                img.style.borderRadius = '5px';
                previewContainer.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    });

</script>


<%- include('./_layouts/footer') %>
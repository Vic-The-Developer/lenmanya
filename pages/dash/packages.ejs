<%- include('./_layouts/header') %>


<!-- Main Content -->
<div class="container-fluid py-4">
    <div class="container">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Manage Travel Packages</h2>
            <a href="#" class="btn btn-primary">
                <i class="fa fa-plus me-2"></i>Add New Package
            </a>
        </div>
        <!-- Table Container -->
        <div class="table-container">
            <div class="mb-3 d-flex justify-content-between">
                <!-- Search Input -->
                <div class="input-group w-50">
                    <input type="text" class="form-control" placeholder="Search by package name, category...">
                    <button class="btn btn-outline-secondary" type="button">
                        <i class="fa fa-search"></i>
                    </button>
                </div>
            </div>
            <!-- Packages Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover text-center">
                    <thead class="table-primary">
                        <tr>
                            <th>#</th>
                            <th>Package Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Date Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Example Row -->
                        <tr>
                            <td>1</td>
                            <td>Maasai Mara Safari</td>
                            <td>Wildlife Tour</td>
                            <td>$1,500</td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td>2024-08-01</td>
                            <td class="action-buttons">
                                <a href="#" class="text-info"><i class="fa fa-edit"></i></a>
                                <a href="#" class="text-danger"><i class="fa fa-trash"></i></a>
                                <a href="#" class="text-success"><i class="fa fa-eye"></i></a>
                                <a href="#" class="text-secondary"><i class="fa fa-toggle-on"></i></a>
                            </td>
                        </tr>
                        <!-- Another Example Row -->
                        <tr>
                            <td>2</td>
                            <td>Zanzibar Beach Getaway</td>
                            <td>Beach Holiday</td>
                            <td>$1,200</td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                            <td>2024-07-25</td>
                            <td class="action-buttons">
                                <a href="#" class="text-info"><i class="fa fa-edit"></i></a>
                                <a href="#" class="text-danger"><i class="fa fa-trash"></i></a>
                                <a href="#" class="text-success"><i class="fa fa-eye"></i></a>
                                <a href="#" class="text-secondary"><i class="fa fa-toggle-on"></i></a>
                            </td>
                        </tr>
                        <!-- Add More Rows Dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('./_layouts/footer') %>
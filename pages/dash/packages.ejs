<%- include('./_layouts/header') %>


<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= successMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<% if (errorMessage) { %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <%= errorMessage %>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
    </div>
<% } %>

<!-- Main Content -->
<div class="container-fluid py-4">
    <div class="container">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-primary">Manage Travel Packages</h2>
            <a href="#" class="btn btn-primary" data-toggle="modal" data-target=".bd-package-modal-lg">
                <i class="fa fa-plus me-2"></i>Add New Package
            </a>
        </div>

        <!-- Key Metrics Section -->
        <div class="row mb-4">
            <!-- Total Packages -->
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card card-metric">
                    <div class="row w-100">
                        <div class="col-4 icon-col"><i class="fa fa-folder"></i></div>
                        <div class="col-8">
                            <div class="cardRight">
                                <h5><%= totalPackages || 0 %></h5>
                                <p>Total Packages</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Pending Packages -->
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card card-metric">
                    <div class="row w-100">
                        <div class="col-4 icon-col"><i class="fa fa-hourglass-half"></i></div>
                        <div class="col-8">
                            <div class="cardRight">
                                <h5><%= pendingPackages || 0 %></h5>
                                <p>Pending</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Active Packages -->
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card card-metric">
                    <div class="row w-100">
                        <div class="col-4 icon-col"><i class="fa fa-check-square-o"></i></div>
                        <div class="col-8">
                            <div class="cardRight">
                                <h5><%= activePackages || 0 %></h5>
                                <p>Active</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        

        <!-- Table Container -->
        <div class="table-container">
            <!-- Filter and Search Section -->
            <div class="mb-4">
                <form class="row g-3" action="/admin/filter_package" method="post" enctype="application/x-www-form-urlencoded">
                    <div class="col-md-8">
                        <input type="text" name="search" class="form-control" placeholder="Search by location..." required>
                    </div>
                    <div class="col-md-4 text-end">
                        <button class="btn btn-success" type="submit">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        
            <!-- Packages Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover text-center">
                    <thead class="table-primary">
                        <tr>
                            <th>#</th>
                            <th>Package Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Date Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (packages.length > 0) { %>
                            <% packages.forEach((pkg, index) => { %>
                                <tr>
                                    <td><%= (currentPage - 1) * 10 + index + 1 %></td>
                                    <td><%= pkg.pTitle || '-' %></td>
                                    <td><%= pkg.pLoc || '-' %></td>
                                    <td>$<%= pkg.price || '0.00' %></td>
                                    <td>
                                        <% if (pkg.status === 'Active') { %>
                                            <span class="badge bg-success">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        <% } %>
                                    </td>
                                    <td><%= pkg.createdAt.toISOString().split('T')[0] %></td>
                                    <td>
                                        <a href="#" class="text-info" title="Edit" data-toggle="modal" data-target="#editModal-<%= pkg._id %>"><i class="fa fa-edit"></i></a>
                                        <a href="#" class="text-danger" title="Delete"><i class="fa fa-trash"></i></a>
                                        <a href="#" class="text-success" title="View Details"><i class="fa fa-eye"></i></a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center">No packages available</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        
            <!-- Pagination Controls -->
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <% if (currentPage > 1) { %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/packages/<%= currentPage - 1 %>">Previous</a>
                        </li>
                    <% } %>
        
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="/admin/packages/<%= i %>"><%= i %></a>
                        </li>
                    <% } %>
        
                    <% if (currentPage < totalPages) { %>
                        <li class="page-item">
                            <a class="page-link" href="/admin/packages/<%= currentPage + 1 %>">Next</a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        </div>
        
    </div>
</div>

<!-- Edit package Modal -->
<% packages.forEach((pkg) => { %>
    <!-- Edit Package Modal for <%= pkg.name %> -->
    <div class="modal fade" id="editModal-<%= pkg._id %>" tabindex="-1" role="dialog" aria-labelledby="editModalLabel-<%= pkg._id %>" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel-<%= pkg._id %>">
                        Edit Package: <%= pkg.name %>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form action="/admin/edit_package?id=<%= pkg._id %>" method="post" enctype="application/x-www-form-urlencoded">
    
                        <!-- Package Title -->
                        <div class="mb-3">
                            <label for="pTitle-<%= pkg._id %>" class="form-label">Package Title</label>
                            <input type="text" id="pTitle-<%= pkg._id %>" name="pTitle" class="form-control" value="<%= pkg.name %>">
                        </div>
    
                        <!-- Location -->
                        <div class="mb-3">
                            <label for="pLoc-<%= pkg._id %>" class="form-label">Location</label>
                            <input type="text" id="pLoc-<%= pkg._id %>" name="pLoc" class="form-control" value="<%= pkg.pLoc %>">
                        </div>
    
                        <!-- Days -->
                        <div class="mb-3">
                            <label for="pDays-<%= pkg._id %>" class="form-label">Days</label>
                            <input type="text" id="pDays-<%= pkg._id %>" name="pDays" class="form-control" value="<%= pkg.pDays %>">
                        </div>
    
                        <!-- Price -->
                        <div class="mb-3">
                            <label for="price-<%= pkg._id %>" class="form-label">Cost</label>
                            <input type="text" id="price-<%= pkg._id %>" name="price" class="form-control" value="<%= pkg.price %>">
                        </div>
    
                        <!-- Description -->
                        <div class="mb-3">
                            <label for="description-<%= pkg._id %>" class="form-label">Description</label>
                            <textarea name="description" class="form-control" id="description-<%= pkg._id %>" rows="6"><%= pkg.description %></textarea>
                        </div>
    
                        <!-- Rating -->
                        <div class="mb-3">
                            <label for="rating-<%= pkg._id %>" class="form-label">Rating</label>
                            <input type="text" id="rating-<%= pkg._id %>" name="rating" class="form-control" value="<%= pkg.pRating %>">
                        </div>
    
                        <!-- Update Button -->
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Update Package
                            </button>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
<% }); %>
    

<!-- Create package Modal -->
<div class="modal fade bd-package-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Create a New Package</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <form action="/admin/add_package" method="post" enctype="application/x-www-form-urlencoded">
                <!-- Display Name -->
                <div class="mb-3">
                    <label for="pTitle" class="form-label">Package Title</label>
                    <input type="text" id="pTitle" name="pTitle" class="form-control" placeholder="Enter title">
                </div>
                <!-- Location -->
                <div class="mb-3">
                    <label for="pLoc" class="form-label">Location</label>
                    <input type="text" id="pLoc" name="pLoc" class="form-control" placeholder="Enter Location">
                </div>
                <!-- Number of Days -->
                <div class="mb-3">
                    <label for="pDays" class="form-label">Days</label>
                    <input type="number" id="pDays" name="pDays" class="form-control" placeholder="Enter no of Days">
                </div>
                <!-- Price -->
                <div class="mb-3">
                    <label for="price" class="form-label">Cost</label>
                    <input type="text" id="price" name="price" class="form-control" placeholder="Enter total cost i.e. Ksh27,000 or $300">
                </div>
                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="description" class="form-control" id="description" rows="6"></textarea>
                </div>
                <!-- Rating -->
                <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="number" id="pRating" name="pRating" class="form-control" placeholder="E.g. 4.9">
                </div>
                <!-- Images -->
                <div class="mb-3">
                    <label for="pImage" class="form-label">Upload upto 5 images</label>
                    <input type="file" name="pImages" id="pImages" class="form-control" accept="" multiple>
                </div>
                <div style="margin: 30px 0;">Images preview</div>
                
                <!-- Update Button -->
                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Create Package
                    </button>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
</div>


<%- include('./_layouts/footer') %>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const phoneInput = document.getElementById("whatsapp");
        
            phoneInput.addEventListener("blur", function () {
                let phoneNumber = phoneInput.value.trim();
        
                // Remove all non-digit characters except the leading "+"
                phoneNumber = phoneNumber.replace(/[^\d+]/g, "");
        
                // Handle phone numbers starting with +254 or 07/011/010
                if (phoneNumber.startsWith("+254")) {
                    phoneNumber = "254" + phoneNumber.substring(4); // Remove + and keep 254
                } else if (phoneNumber.startsWith("07") || phoneNumber.startsWith("011") || phoneNumber.startsWith("010")) {
                    phoneNumber = "254" + phoneNumber.substring(1); // Replace 07, 011, 010 with 254
                }
        
                // Ensure the phone number is exactly 12 digits
                if (/^254\d{9}$/.test(phoneNumber)) {
                    phoneInput.value = phoneNumber; // Set formatted number
                } else {
                    alert("Invalid phone number format. Use 07XXXXXXX, 011XXXXXXX, or 010XXXXXXX.");
                    phoneInput.value = ""; // Clear invalid input
                }
            });
        
            // Prevent form submission if the phone number is invalid
            const form = phoneInput.closest("form");
            form.addEventListener("submit", function (event) {
                const phoneNumber = phoneInput.value.trim();
                if (!/^254\d{9}$/.test(phoneNumber)) {
                    alert("Please enter a valid phone number in the correct format.");
                    event.preventDefault(); // Stop form submission
                }
            });
        });
    </script>
        


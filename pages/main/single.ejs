                                        <%= recentBlog.bTitle %>
                                    </a>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    <!-- Recent Posts End -->

                    <!-- Tag Cloud -->
                    <div class="mb-5">
                        <h4 class="text-uppercase mb-4" style="letter-spacing: 5px;">Tag Cloud</h4>
                        <div class="d-flex flex-wrap m-n1">
                            <a href="" class="btn btn-light m-1">Design</a>
                            <a href="" class="btn btn-light m-1">Development</a>
                            <a href="" class="btn btn-light m-1">Marketing</a>
                            <a href="" class="btn btn-light m-1">SEO</a>
                            <a href="" class="btn btn-light m-1">Writing</a>
                            <a href="" class="btn btn-light m-1">Consulting</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Blog End -->


    <!-- Footer Start -->
    <%- include('./_layouts/footer') %>
    <!-- Footer End -->


    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="fa fa-angle-double-up"></i></a>


    <script>
        // Assume `package` is dynamically passed from the server as a single package object
        const package = <%- blog2 %>;
    
        console.log('Package:', package);
    
        // Function to parse a string of HTML into DOM content
        const stringToHTML = string => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(string, 'text/html');
            return doc.body.innerHTML; // Return the entire body content as innerHTML
        };
    
        // Function to populate the description div with parsed HTML
        function populateDiv(pkgId, description) {
            const container = document.getElementById('blogContent');
            console.log('Container:', container);
    
            if (container) {
                const htmlContent = stringToHTML(description);
                console.log('Parsed HTML Content:', htmlContent);
    
                if (htmlContent) {
                    // Directly set innerHTML to the container
                    container.innerHTML = htmlContent;
                } else {
                    console.warn(`HTML content for package ${pkgId} is null or undefined.`);
                }
            } else {
                console.warn(`Container with ID desc-${pkgId} not found.`);
            }
        }
    
        // Populate the single package description div
        if (package._id && package.content) {
            populateDiv(package._id, package.content);
        } else {
            console.warn('Package is missing an ID or description.');
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const phoneInput = document.getElementById("whatsapp");
        
            phoneInput.addEventListener("blur", function () {
                let phoneNumber = phoneInput.value.trim();
        
                // Remove all non-digit characters except the leading "+"
                phoneNumber = phoneNumber.replace(/[^\d+]/g, "");
        
                // Handle phone numbers starting with +254 or 07/011/010
                if (phoneNumber.startsWith("+254")) {
                    phoneNumber = "254" + phoneNumber.substring(4); // Remove + and keep 254
                } else if (phoneNumber.startsWith("07") || phoneNumber.startsWith("011") || phoneNumber.startsWith("010")) {
                    phoneNumber = "254" + phoneNumber.substring(1); // Replace 07, 011, 010 with 254
                }
        
                // Ensure the phone number is exactly 12 digits
                if (/^254\d{9}$/.test(phoneNumber)) {
                    phoneInput.value = phoneNumber; // Set formatted number
                } else {
                    alert("Invalid phone number format. Use 07XXXXXXX, 011XXXXXXX, or 010XXXXXXX.");
                    phoneInput.value = ""; // Clear invalid input
                }
            });
        
            // Prevent form submission if the phone number is invalid
            const form = phoneInput.closest("form");
            form.addEventListener("submit", function (event) {
                const phoneNumber = phoneInput.value.trim();
                if (!/^254\d{9}$/.test(phoneNumber)) {
                    alert("Please enter a valid phone number in the correct format.");
                    event.preventDefault(); // Stop form submission
                }
            });
        });
    </script>


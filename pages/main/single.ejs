                                <div class="blog-date">
                                    <h6 class="font-weight-bold mb-n1">
                                        <%= blog.createdAt.toLocaleString('default', { day: '2-digit' }) %>
                                    </h6>
                                    <small class="text-white text-uppercase">
                                        <%= blog.createdAt.toLocaleString('default', { month: 'short' }) %>
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white mb-3" style="padding: 30px;">

                                            <input type="text" id="date1" class="form-control p-4 datetimepicker-input" placeholder="Enter Date" data-target="#date1" data-toggle="datetimepicker" required/>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-3">

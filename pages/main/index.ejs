            const modalTitle = document.getElementById('itineraryModalLabel');
            const modalContent = document.getElementById('modal-content');
            
            itineraryModal.addEventListener('show.bs.modal', function(event) {
                const clickedLink = event.relatedTarget;
                const itineraryId = clickedLink.getAttribute('data-itinerary');
                
                if (itineraries[itineraryId]) {
                    modalTitle.textContent = itineraries[itineraryId].title;
                    modalContent.innerHTML = itineraries[itineraryId].content;
                } else {
                    modalTitle.textContent = "Itinerary Not Found";
                    modalContent.innerHTML = "<p>Sorry, the itinerary details are not available at the moment.</p>";
                }
            });
            
            // Clear modal content when hidden
            itineraryModal.addEventListener('hidden.bs.modal', function() {
                modalTitle.textContent = "Itinerary Details";
                modalContent.innerHTML = "";
            });
        });
